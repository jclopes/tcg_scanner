node_modules/
dist/
*.local

# Copied from node_modules by vite.config.ts's copyTesseractToPublic plugin
# on every dev/build run — always regenerated, never hand-edited.
/public/tesseract/

# Backups written by scripts/update-cyberpunk-sets.mjs before it replaces sets.json.
/src/data/games/cyberpunk/*.json.bak

# Raw card dump that riftbound/sets.json was derived from; not bundled.
/src/data/games/riftbound/riftbound_cards_detailed.json

# Ad hoc debug/validation card captures; not read by any source or test file.
/src/data/screenshot/
